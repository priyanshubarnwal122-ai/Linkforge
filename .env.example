# LinkForge Environment Variables Example
# Copy this file to .env and fill in your values.
# On Render: set these in the Dashboard -> Environment section (never commit .env).

ENVIRONMENT=development          # development | staging | production
# This value is only a local-development placeholder; replace it outside local Docker.
SECRET_KEY=local-development-only-change-me-1234567890

# --- Database ----------------------------------------------------------
# Local Docker (docker-compose overrides *_HOST for the api container):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linkforge
POSTGRES_USER=linkforge_user
POSTGRES_PASSWORD=linkforge_password

# Render managed Postgres (set DATABASE_URL directly from the Render dashboard;
# the app auto-converts postgresql:// ? postgresql+asyncpg:// for SQLAlchemy):
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Redis -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# On Render, REDIS_HOST and REDIS_PORT are injected automatically via render.yaml.

# --- Auth --------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional � get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# On Render, RENDER_EXTERNAL_URL is auto-injected so the redirect URI is derived automatically.

# --- AI Alias Recommender (optional) -----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=10
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- App ---------------------------------------------------------------
BASE_URL=http://localhost:8000
SHORT_CODE_LENGTH=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
LOG_FORMAT=console     # use "json" in production
