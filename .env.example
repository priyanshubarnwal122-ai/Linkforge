# Copy this file to .env and fill in your values.
# Never commit .env to git.

ENVIRONMENT=production                        # development | staging | production
SECRET_KEY=change_me_to_a_random_64_char_string

POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
POSTGRES_DB=linkforge
POSTGRES_USER=linkforge_user
POSTGRES_PASSWORD=your_strong_password
DB_POOL_SIZE=10                               # raise for high traffic

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=                               # leave blank if no auth

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Phase 2 — leave blank to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback

BASE_URL=https://yourdomain.com
SHORT_CODE_LENGTH=7

# CORS — JSON list of allowed frontend origins
CORS_ORIGINS=["https://yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com", "www.yourdomain.com"]

LOG_LEVEL=INFO
LOG_FORMAT=json                               # json for prod, console for dev
